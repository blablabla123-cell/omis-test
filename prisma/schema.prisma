datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

enum UserRole {
    ADMIN
    USER
}

model User {
    id       String   @id @default(uuid())
    email    String   @unique
    password String
    role     UserRole @default(USER)

    deletedAt         DateTime?
    perfomanceReviews PerfomanceReview[]

    @@map("users")
}

model Metric {
    id                Int                @id @default(autoincrement())
    name              String
    targetValue       Int
    weight            Decimal            @db.Decimal(3, 2)
    perfomanceReviews PerfomanceReview[]

    @@map("metrics")
}

model PerfomanceReview {
    id        Int      @id @default(autoincrement())
    user      User     @relation(fields: [userId], references: [id])
    userId    String
    metric    Metric   @relation(fields: [metricId], references: [id])
    metricId  Int
    factValue Int
    period    DateTime

    @@map("perfomance-reviews")
}
